{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/((?!app$).*)", "destination": "/api/app?__path=/api/$1" },
    { "source": "/r/:path*", "destination": "/api/app?__path=/r/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/app.mjs": {
      "maxDuration": 60,
      "includeFiles": "dist/index.html"
    }
  }
}
